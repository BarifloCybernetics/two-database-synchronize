# ==============================================================================
# Node A Environment Configuration (Multi-Network Static IP Deployment)
# ==============================================================================

# Node Identity
NODE_NAME=node-a
NODE_ROLE=active
CONTAINER_NAME=postgres-node-a

# ------------------------------------------------------------------------------
# NETWORK CONFIGURATION (Different Networks & Static IPs)
# ------------------------------------------------------------------------------
# Static IP of THIS server (Server A / Data Center 1)
# Example: 192.168.1.10, or your public IP / VPN IP
LOCAL_STATIC_IP=192.168.1.10
LOCAL_PORT=5432

# Static IP of the REMOTE server (Server B / Data Center 2)
# Example: 192.168.2.20, or Node B's public IP / VPN IP
REMOTE_STATIC_IP=192.168.2.20
REMOTE_PORT=5432

# Hostname / IP used by Node A to connect to Node B
# Set to $REMOTE_STATIC_IP when deployed on separate servers
REMOTE_HOST=192.168.2.20

# ------------------------------------------------------------------------------
# LOCAL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_DB=appdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_master_pw
POSTGRES_PORT=5432
HOST_PORT=5432

# Local Replication User (Must be allowed in pg_hba.conf from REMOTE_STATIC_IP)
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replicator_secure_pw_123

# ------------------------------------------------------------------------------
# REMOTE DATABASE (NODE B) CREDENTIALS
# ------------------------------------------------------------------------------
REMOTE_NODE_NAME=node-b
REMOTE_DB=appdb
REMOTE_REPLICATION_USER=replicator
REMOTE_REPLICATION_PASSWORD=replicator_secure_pw_123

# Connection Security across WAN / Cross-Network ('prefer', 'require', 'verify-full')
REPLICATION_SSL_MODE=prefer

# ------------------------------------------------------------------------------
# PUBLICATION & SUBSCRIPTION NAMES
# ------------------------------------------------------------------------------
PUBLICATION_NAME=pub_node_a
REMOTE_PUBLICATION_NAME=pub_node_b
SUBSCRIPTION_NAME=sub_node_b_to_a
REPLICATION_SLOT_NAME=sub_node_b_to_a

# ------------------------------------------------------------------------------
# HEALTH CHECK & RECONCILIATION THRESHOLDS
# ------------------------------------------------------------------------------
MAX_ALLOWED_LAG_BYTES=10485760
HEALTH_CHECK_INTERVAL_SEC=10
RECONCILIATION_CRON="0 */2 * * *"

# ------------------------------------------------------------------------------
# ALERTING & NOTIFICATIONS (TELEGRAM & EMAIL)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_SMARTHOST=smtp.example.com:587
SMTP_FROM=alerts@ha-postgres.local
SMTP_AUTH_USER=
SMTP_AUTH_PASSWORD=
ALERT_EMAIL_TO=dba-team@example.com
